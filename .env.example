# ============ HEATSHIELD INDIA - environment configuration ============
# Copy to .env and adjust as needed. Defaults work out of the box
# (Demo Mode requires NO internet access).

# --- Database ---
# Docker (PostgreSQL + PostGIS):
DATABASE_URL=postgresql+psycopg2://heatshield:heatshield@localhost:5432/heatshield
# Local dev without Docker (SQLite - auto-created):
# DATABASE_URL=sqlite:///./data/heatshield.db
POSTGRES_USER=heatshield
POSTGRES_PASSWORD=heatshield
POSTGRES_DB=heatshield
POSTGRES_PORT=5432

# --- Weather provider ---
# demo  -> offline demo weather generator (no internet required)
# openmeteo -> live Open-Meteo API (requires internet)
WEATHER_PROVIDER=demo

# Demo weather scenario:
# normal_summer | moderate_heatwave | severe_humid | extreme_dry
DEMO_SCENARIO=severe_humid

# --- Open-Meteo (only used when WEATHER_PROVIDER=openmeteo) ---
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# --- API / CORS ---
CORS_ORIGINS=*
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Frontend (browser calls the backend directly) ---
NEXT_PUBLIC_API_URL=http://localhost:8000